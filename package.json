{
  "name": "netsim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D world network heatmap simulator — RF propagation, atmospheric physics, satcom link budgets and automatic cell planning on a globe",
  "scripts": {
    "dev": "vite --port 5190",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5190",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/fetch-data.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
